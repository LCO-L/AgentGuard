# ── AgentGuard ULTRA 환경변수 예시 (Railway Variables에 동일하게 설정) ──

# ── AI 판단/통역 엔진 ────────────────────────────────
# provider: auto | ollama | claude | openrouter | off  (기본 auto)
#  - 요청 헤더(X-AI-Provider 등)로 런타임 오버라이드 가능(UI 설정이 우선)
AG_AI_PROVIDER=auto

# 온디바이스(Ollama) — 키 불필요
AG_OLLAMA_URL=http://localhost:11434
AG_OLLAMA_MODEL=qwen3:8b

# 클라우드(선택) — 키가 있으면 auto 에서도 폴백으로 사용
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
AG_MODEL=claude-sonnet-4-5
AG_OPENROUTER_MODEL=qwen/qwen3-8b
AG_AI_TIMEOUT=20

# ── API 보호/운영 ───────────────────────────────────
# API 키 인증 (비워두면 인증 없음 — 해커톤 모드)
AG_API_KEY=

# CORS 허용 오리진 (쉼표 구분, 기본 *)
AG_CORS_ORIGINS=*

# 업로드 제한(MB)
AG_MAX_UPLOAD_MB=30

# 이력/지문 캐시 경로
AG_HISTORY_PATH=.cache/history.jsonl
AG_HISTORY_MAX=1000
AG_CACHE_DIR=.cache

# Railway가 자동 주입
PORT=8000
