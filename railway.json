{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r requirements.txt && (python scripts/pack_extension.py || echo 'CRX 패키징 건너뜀 — /extension.zip 즉석 배포로 대체')",
    "watchPatterns": ["**"]
  },
  "deploy": {
    "startCommand": "python -m uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8080}",
    "healthcheckPath": "/v1/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
